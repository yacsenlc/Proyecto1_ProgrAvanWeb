@{
    ViewData["Title"] = "Acceso Especialista";
}

<div class="container mt-5 text-center">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">
            Especialista, @ViewBag.NombreUsuarioEspecialista
        </h1>

        <p>Desde aquí podrás administrar y atender los tickets.</p>
    </div>


</div>

<div class="container mt-4">

    <h2>Help Desk- Solicitudes de trabajo</h2>
    <p>Consulta, asigna técnicos y administra el estado de tus tiquetes.</p>

    <!-- BUSCADOR -->
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" id="buscarTiquete"
                   class="form-control"
                   placeholder="Buscar por título, descripción o categoría..." />
        </div>
    </div>

    <!-- TABLA -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Categoría</th>
                    <th>Técnico asignado</th>
                    <th>Estado</th>
                    <th style="min-width: 180px;">Acciones</th>
                </tr>
            </thead>

            <tbody id="tablaTiquetes">
            </tbody>

        </table>
    </div>

</div>

<script>
    // GUARDAR CAMBIOS DEL TIQUETE
    function guardarTiquete(boton) {

        let fila = boton.closest("tr");

        let tecnico = fila.querySelector(".tecnico").value;
        let estado = fila.querySelector(".estado").value;

        alert(
            "Técnico asignado: " + (tecnico || "Sin asignar") +
            "\nEstado: " + estado
        );

        // Aquí puedes realizar el AJAX para guardar
        // los cambios en la base de datos.
    }



</script>


<script>

    function guardarAsignacion(indice) {

        const tiquetes = obtenerTiquetes();

        const filas = document.querySelectorAll("#tablaTiquetes tr");

        let filaEncontrada = null;

        // Buscar la fila correspondiente al tiquete
        filas.forEach(fila => {

            const boton = fila.querySelector(
                `button[onclick="guardarAsignacion(${indice})"]`
            );

            if (boton) {
                filaEncontrada = fila;
            }

        });

        if (!filaEncontrada) return;

        const tecnico = filaEncontrada.querySelector(".tecnico").value;
        const estado = filaEncontrada.querySelector(".estado").value;

        tiquetes[indice].tecnicoAsignado = tecnico;
        tiquetes[indice].estado = estado;

        almacenarTiquetes(tiquetes);

        alert("Tiquete actualizado correctamente.");

        mostrarTiquetes(
            document.getElementById("buscarTiquete").value
        );
    }



    // Obtener tiquetes
    function obtenerTiquetes() {
        return JSON.parse(localStorage.getItem("tiquetes")) || [];
    }

    // Guardar tiquetes
    function almacenarTiquetes(tiquetes) {
        localStorage.setItem("tiquetes", JSON.stringify(tiquetes));
    }

    // Mostrar tabla

    function mostrarTiquetes(filtro = "") {

        let tiquetes = obtenerTiquetes();

        const tabla = document.getElementById("tablaTiquetes");

        tabla.innerHTML = "";

        const resultados = tiquetes
            .map((tiquete, indice) => ({ tiquete, indice }))
            .filter(item => {

                const texto = (
                    item.tiquete.titulo + " " +
                    item.tiquete.descripcion + " " +
                    item.tiquete.categoria
                ).toLowerCase();

                return texto.includes(filtro.toLowerCase());
            });

        if (resultados.length === 0) {

            tabla.innerHTML = `
            <tr>
                <td colspan="6" class="text-center">
                    No se encontraron tiquetes.
                </td>
            </tr>`;

            return;
        }

        resultados.forEach(item => {

            const tiquete = item.tiquete;
            const indice = item.indice;

            const fila = document.createElement("tr");
            // Pintar la fila de verde si está resuelto
            // COLORES SEGÚN EL ESTADO
            switch (tiquete.estado || "Abierto") {

                case "Abierto":
                case "Nuevo":
                    fila.classList.add("fila-abierto");
                    break;

                case "En Proceso":
                    fila.classList.add("fila-proceso");
                    break;

                case "Resuelto":
                    fila.classList.add("fila-resuelto");
                    break;

                case "Cerrado":
                    fila.classList.add("fila-cerrado");
                    break;
            }

            // TÍTULO
            const titulo = document.createElement("td");
            titulo.textContent = tiquete.titulo;

            // DESCRIPCIÓN
            const descripcion = document.createElement("td");
            descripcion.textContent = tiquete.descripcion;

            // CATEGORÍA
            const categoria = document.createElement("td");
            categoria.textContent = tiquete.categoria;

            // TÉCNICO ASIGNADO
            const tecnico = document.createElement("td");

            tecnico.innerHTML = `
            <select class="form-select tecnico">
                <option value="">Sin asignar</option>
                <option value="Maria">María</option>
                <option value="Juan">Juan</option>
            </select>
        `;

            tecnico.querySelector("select").value =
                tiquete.tecnicoAsignado || "";

            // ESTADO
            const estado = document.createElement("td");

            estado.innerHTML = `
            <select class="form-select estado">
                <option value="Abierto">Abierto</option>
                <option value="En Proceso">En Proceso</option>
                <option value="Resuelto">Resuelto</option>
                <option value="Cerrado">Cerrado</option>
            </select>
        `;

            estado.querySelector("select").value =
                tiquete.estado || "Abierto";

            // ACCIONES
            const acciones = document.createElement("td");

            acciones.innerHTML = `
            <button class="btn btn-info btn-sm mb-1"
                onclick="verDetalles(${indice})">
                Detalles
            </button>

            <button class="btn btn-warning btn-sm mb-1"
                onclick="abrirActualizar(${indice})">
                Actualizar
            </button>

            <button class="btn btn-danger btn-sm mb-1"
                onclick="eliminarTiquete(${indice})">
                Eliminar
            </button>

            <button class="btn btn-success btn-sm mb-1"
                onclick="abrirComentarios(${indice})">
                Comentarios
            </button>

            <button class="btn btn-primary btn-sm mb-1"
                onclick="guardarAsignacion(${indice})">
                Guardar
            </button>
        `;

            // AGREGAR LAS 6 COLUMNAS
            fila.appendChild(titulo);
            fila.appendChild(descripcion);
            fila.appendChild(categoria);
            fila.appendChild(tecnico);
            fila.appendChild(estado);
            fila.appendChild(acciones);

            tabla.appendChild(fila);

        });
    }



    // BUSCADOR
    document.getElementById("buscarTiquete")
        .addEventListener("input", function () {

            mostrarTiquetes(this.value);

        });


    // VER DETALLES
    function verDetalles(indice) {

        const tiquetes = obtenerTiquetes();
        const tiquete = tiquetes[indice];

        document.getElementById("detalleTitulo").textContent = tiquete.titulo;
        document.getElementById("detalleDescripcion").textContent = tiquete.descripcion;
        document.getElementById("detalleCategoria").textContent = tiquete.categoria;

        new bootstrap.Modal(
            document.getElementById("modalDetalles")
        ).show();
    }


    // ABRIR ACTUALIZAR
    function abrirActualizar(indice) {

        const tiquetes = obtenerTiquetes();
        const tiquete = tiquetes[indice];

        document.getElementById("editarIndice").value = indice;
        document.getElementById("editarTitulo").value = tiquete.titulo;
        document.getElementById("editarDescripcion").value = tiquete.descripcion;
        document.getElementById("editarCategoria").value = tiquete.categoria;

        new bootstrap.Modal(
            document.getElementById("modalActualizar")
        ).show();
    }


    // GUARDAR CAMBIOS

    function guardarCambios() {

        const indice = Number(document.getElementById("editarIndice").value);

        const tiquetes = obtenerTiquetes();

        const titulo = document.getElementById("editarTitulo").value.trim();
        const descripcion = document.getElementById("editarDescripcion").value.trim();
        const categoria = document.getElementById("editarCategoria").value;

        if (!titulo || !descripcion || !categoria) {
            alert("Completa todos los campos.");
            return;
        }

        // Actualizar los datos
        tiquetes[indice].titulo = titulo;
        tiquetes[indice].descripcion = descripcion;
        tiquetes[indice].categoria = categoria;

        // Guardar en localStorage
        almacenarTiquetes(tiquetes);


        // Cerrar modal de actualización


        // Actualizar la tabla
        mostrarTiquetes(document.getElementById("buscarTiquete").value);

        // Mostrar mensaje de éxito
        new bootstrap.Modal(
            document.getElementById("modalActualizado")
        ).show();
    }



    // ELIMINAR
    function eliminarTiquete(indice) {

        if (confirm("¿Estás seguro de que deseas eliminar este tiquete?")) {

            let tiquetes = obtenerTiquetes();

            tiquetes.splice(indice, 1);

            almacenarTiquetes(tiquetes);

            mostrarTiquetes(document.getElementById("buscarTiquete").value);

            alert("Tiquete eliminado correctamente.");
        }
    }


    // ABRIR COMENTARIOS
    function abrirComentarios(indice) {

        const tiquetes = obtenerTiquetes();
        const tiquete = tiquetes[indice];

        document.getElementById("comentarioIndice").value = indice;
        document.getElementById("nuevoComentario").value = "";

        const lista = document.getElementById("listaComentarios");

        lista.innerHTML = "";

        const comentarios = tiquete.comentarios || [];

        if (comentarios.length === 0) {

            lista.textContent = "Todavía no hay comentarios.";

        } else {

            comentarios.forEach(comentario => {

                const parrafo = document.createElement("p");
                parrafo.className = "border rounded p-2";
                parrafo.textContent = comentario;

                lista.appendChild(parrafo);

            });
        }

        new bootstrap.Modal(
            document.getElementById("modalComentarios")
        ).show();
    }


    // GUARDAR COMENTARIO
    function guardarComentario() {

        const indice = Number(document.getElementById("comentarioIndice").value);

        const comentario = document.getElementById("nuevoComentario").value.trim();

        if (!comentario) {
            alert("Debes escribir un comentario.");
            return;
        }

        const tiquetes = obtenerTiquetes();

        if (!tiquetes[indice].comentarios) {
            tiquetes[indice].comentarios = [];
        }

        tiquetes[indice].comentarios.push(comentario);

        almacenarTiquetes(tiquetes);

        alert("Comentario agregado correctamente.");

        bootstrap.Modal.getInstance(
            document.getElementById("modalComentarios")
        ).hide();
    }


    // CARGAR TABLA AL INICIAR
    document.addEventListener("DOMContentLoaded", function () {

        mostrarTiquetes();

    });


    function cerrarModalActualizado() {

        const modalElemento = document.getElementById("modalActualizado");

        const modal = bootstrap.Modal.getInstance(modalElemento);

        if (modal) {
            modal.hide();
        }
    }

</script>

<style>
    /* Estado nuevo o abierto */
    .fila-abierto td {
        background-color: #cfe2ff !important;
        color: #084298;
    }

    /* Estado en proceso */
    .fila-proceso td {
        background-color: #e2d9f3 !important;
        color: #432874;
    }

    /* Estado resuelto */
    .fila-resuelto td {
        background-color: #d1e7dd !important;
        color: #0f5132;
    }

    /* Estado cerrado */
    .fila-cerrado td {
        background-color: #e2e3e5 !important;
        color: #41464b;
    }
</style>


<!-- MODAL DETALLES -->
<div class="modal fade" id="modalDetalles" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Detalles del tiquete</h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p><strong>Título:</strong> <span id="detalleTitulo"></span></p>
                <p><strong>Descripción:</strong> <span id="detalleDescripcion"></span></p>
                <p><strong>Categoría:</strong> <span id="detalleCategoria"></span></p>
            </div>

        </div>
    </div>
</div>


<!-- MODAL ACTUALIZAR -->
<div class="modal fade" id="modalActualizar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Actualizar tiquete</h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="editarIndice" />

                <div class="mb-3">
                    <label class="form-label">Título</label>
                    <input type="text" id="editarTitulo"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea id="editarDescripcion"
                              class="form-control" rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Categoría</label>
                    <select id="editarCategoria" class="form-select">
                        <option value="Soporte técnico">Soporte técnico</option>
                        <option value="Mantenimiento">Mantenimiento</option>
                        <option value="Solicitud">Solicitud</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn btn-primary"
                        onclick="guardarCambios()">
                    Guardar cambios
                </button>
            </div>

        </div>
    </div>
</div>


<!-- MODAL ACTUALIZACIÓN EXITOSA -->
<div class="modal fade" id="modalActualizado" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">¡Actualización exitosa!</h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <h2 class="text-success">✓</h2>
                <p>¡Datos actualizados correctamente!</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary"
                        onclick="cerrarModalActualizado()">
                    Aceptar
                </button>
            </div>

        </div>
    </div>
</div>



<!-- MODAL COMENTARIOS -->
<div class="modal fade" id="modalComentarios" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Comentarios del tiquete</h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="comentarioIndice" />

                <label class="form-label">Escribe tu comentario:</label>

                <textarea id="nuevoComentario"
                          class="form-control"
                          rows="4"
                          placeholder="Escribe aquí tu comentario..."></textarea>

                <div class="mt-3">
                    <h6>Comentarios anteriores</h6>
                    <div id="listaComentarios"></div>
                </div>

            </div>

            <div class="modal-footer">

                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

                <button type="button" class="btn btn-primary"
                        onclick="guardarComentario()">
                    Enviar comentario
                </button>

            </div>

        </div>
    </div>
</div>