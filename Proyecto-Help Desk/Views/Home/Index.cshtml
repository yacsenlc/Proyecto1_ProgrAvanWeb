
@{
    ViewData["Title"] = "Inicio - Help Desk";
}

<div class="container mt-5">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <div class="text-center mb-5">
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <h1 class="display-4 fw-bold">Bienvenido a Help Desk</h1>
        <p class="lead">
            Sistema de gestión de solicitudes de soporte técnico
        </p>
    </div>

    <div class="row justify-content-center g-4">

        <!-- CUADRO USUARIO -->
        <div class="col-md-5">
            <div class="card tarjeta-usuario shadow text-center h-100">
                <div class="card-body p-5">

                    <div class="mb-3">
                        <i class="bi bi-person-circle"
                           style="font-size: 65px; color: #0d6efd;"></i>
                    </div>

                    <h2 class="card-title">Usuario</h2>

                    <p class="card-text">
                        Ingresa como usuario para crear tickets
                        y consultar tus solicitudes de soporte.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Login"
                       class="btn btn-primary btn-lg mt-3">
                        Ingresar
                    </a>

                </div>
            </div>
        </div>

        <!-- CUADRO ESPECIALISTA -->
        <div class="col-md-5">
            <div class="card tarjeta-especialista shadow text-center h-100">
                <div class="card-body p-5">

                    <div class="mb-3">
                        <i class="bi bi-person-gear"
                           style="font-size: 65px; color: #198754;"></i>
                    </div>

                    <h2 class="card-title">Especialista</h2>

                    <p class="card-text">
                        Ingresa como especialista para administrar
                        y atender los tickets de soporte técnico.
                    </p>

                    <a asp-controller="Home"
                       asp-action="LoginEspecialist"
                       class="btn btn-success btn-lg mt-3">
                        Ingresar
                    </a>

                </div>
            </div>
        </div>

    </div>





</div>



<style>
    /* Transición de las tarjetas */
    .card {
        transition: all 0.3s ease;
        border: 2px solid transparent;
        border-radius: 15px;
    }

    /* Efecto al pasar el cursor por Usuario */
    .tarjeta-usuario:hover {
        background-color: #e7f1ff;
        border-color: #0d6efd;
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 10px 25px rgba(13, 110, 253, 0.25) !important;
    }

    /* Efecto al pasar el cursor por Especialista */
    .tarjeta-especialista:hover {
        background-color: #e8f5e9;
        border-color: #198754;
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 10px 25px rgba(25, 135, 84, 0.25) !important;
    }

    /* Efecto de los botones */
    .btn {
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: scale(1.08);
        }
</style>