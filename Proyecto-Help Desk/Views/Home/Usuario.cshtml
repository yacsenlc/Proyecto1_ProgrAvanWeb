
@{
    ViewData["Title"] = "Panel de Usuario";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">
            Bienvenido, @ViewBag.NombreUsuario
        </h1>

        <p class="lead">
            ¿Qué deseas hacer hoy?
        </p>
    </div>

    <div class="row justify-content-center g-4">

        <!-- CREAR TICKET -->
        <div class="col-md-5">
            <div class="card tarjeta-crear shadow text-center h-100">
                <div class="card-body p-5">

                    <i class="bi bi-plus-circle"
                       style="font-size: 65px; color: #0d6efd;"></i>

                    <h2 class="card-title mt-3">
                        Crear ticket
                    </h2>

                    <p class="card-text">
                        Registra un nuevo problema o solicitud
                        para recibir soporte técnico.
                    </p>

                    <a asp-controller="Tickets"
                       asp-action="Crear"
                       class="btn btn-primary btn-lg mt-3">
                        Crear ticket
                    </a>

                </div>
            </div>
        </div>

        <!-- MIS TICKETS -->
        <div class="col-md-5">
            <div class="card tarjeta-consultar shadow text-center h-100">
                <div class="card-body p-5">

                    <i class="bi bi-clipboard-check"
                       style="font-size: 65px; color: #198754;"></i>

                    <h2 class="card-title mt-3">
                        Mis tickets
                    </h2>

                    <p class="card-text">
                        Consulta tus solicitudes y revisa
                        el estado actual de cada ticket.
                    </p>

                    <a asp-controller="Tickets"
                       asp-action="MisTickets"
                       class="btn btn-success btn-lg mt-3">
                        Consultar tickets
                    </a>

                </div>
            </div>
        </div>

    </div>

    <div class="text-center mt-5">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Volver al inicio
        </a>
    </div>

</div>

<style>

    .card {
        border-radius: 15px;
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

    .tarjeta-crear:hover {
        background-color: #e7f1ff;
        border-color: #0d6efd;
        transform: translateY(-8px);
        box-shadow: 0 10px 25px rgba(13,110,253,0.2) !important;
    }

    .tarjeta-consultar:hover {
        background-color: #e8f5e9;
        border-color: #198754;
        transform: translateY(-8px);
        box-shadow: 0 10px 25px rgba(25,135,84,0.2) !important;
    }

    .btn {
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: scale(1.05);
        }
</style>
