
@model Proyecto_Help_Desk.Models.Ticket

@{
    ViewBag.Title = "Crear tiquete";
}

<div class="container mt-4">

    <div class="formulario-tiquete">

        <h2>Nuevo tiquete</h2>
        <p>Completa los siguientes datos:</p>

        <form id="formTiquete">

            <div class="mb-3">
                <label class="form-label">Título</label>
                <input type="text" id="titulo" class="form-control"
                       placeholder="Ingrese el título" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea id="descripcion" class="form-control"
                          rows="4" placeholder="Ingrese la descripción"
                          required></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label">Categoría</label>
                <select id="categoria" class="form-select" required>
                    <option value="">Seleccione una categoría</option>
                    <option value="Soporte técnico">Soporte técnico</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                    <option value="Solicitud">Solicitud</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>

            <button type="submit" class="btn btn-guardar">
                Crear tiquete
            </button>

        </form>

    </div>
</div>


<!-- MODAL DE ÉXITO -->
<div class="modal fade" id="modalExito" tabindex="-1"
     aria-labelledby="modalExitoLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalExitoLabel">
                    ¡Tiquete creado!
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <h4 class="text-success">✓</h4>
                <p>El tiquete se creó exitosamente.</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary"
                        id="btnAceptar">
                    Aceptar
                </button>
            </div>

        </div>
    </div>
</div>

<script>

document.getElementById("formTiquete").addEventListener("submit", function(e) {

    e.preventDefault();

    const tiquete = {
        titulo: document.getElementById("titulo").value,
        descripcion: document.getElementById("descripcion").value,
        categoria: document.getElementById("categoria").value
    };

    let tiquetes = JSON.parse(localStorage.getItem("tiquetes")) || [];

    tiquetes.push(tiquete);

    localStorage.setItem("tiquetes", JSON.stringify(tiquetes));

    // Mostrar modal de éxito
    const modal = new bootstrap.Modal(
        document.getElementById("modalExito")
    );

    modal.show();

    // Limpiar formulario
    document.getElementById("formTiquete").reset();

});

// Al aceptar, ir a MisTickets
document.getElementById("btnAceptar").addEventListener("click", function() {

    window.location.href = '@Url.Action("Crear", "Tickets")';

});

</script>

<style>
    body {
        background: linear-gradient(135deg, #dbeafe, #e9d5ff);
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    .formulario-tiquete {
        background-color: #ffffff;
        padding: 35px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(70, 60, 120, 0.15);
        max-width: 700px;
        margin: 40px auto;
    }

        .formulario-tiquete h2 {
            color: #5b4b9a;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .formulario-tiquete p {
            color: #777;
            margin-bottom: 25px;
        }

    .form-label {
        color: #514477;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        border: 1px solid #d8cdef;
        border-radius: 10px;
        padding: 12px;
        background-color: #faf9ff;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #9b83db;
            box-shadow: 0 0 0 0.2rem rgba(155, 131, 219, 0.2);
        }

    .btn-guardar {
        background: linear-gradient(135deg, #8064c9, #a78bfa);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-guardar:hover {
            background: linear-gradient(135deg, #6d50b5, #9272e8);
            color: white;
            transform: translateY(-2px);
        }
</style>

